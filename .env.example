# Konfigurasi environment CekHarga (PRD §13).
#
# File ini SENGAJA ikut Git dan SENGAJA tidak memuat satu pun nilai rahasia.
# Salin menjadi .env.local lalu isi nilainya; .env.local tidak pernah di-commit.

# --------------------------------------------------------------------------
# Sumber data katalog
# --------------------------------------------------------------------------
# demo = fixture lokal berlabel "Data demo" di antarmuka.
# live = database InsForge.
#
# PRD §9: produksi tidak boleh diam-diam fallback ke fixture saat sumber nyata
# gagal. Jadi kalau nilai ini "live" tetapi kredensial di bawah kosong atau
# backend tidak bisa dihubungi, aplikasi akan menampilkan error, BUKAN
# menyajikan data demo sebagai data pasar.
CEKHARGA_DATA_SOURCE=demo

# --------------------------------------------------------------------------
# InsForge (hanya wajib saat CEKHARGA_DATA_SOURCE=live)
# --------------------------------------------------------------------------
# Ambil nilainya dengan:
#   npx @insforge/cli link          # sekali, untuk menghubungkan direktori
#   npx @insforge/cli current       # memastikan project yang benar
# lalu baca .insforge/project.json (field oss_host dan api_key).
#
# Tidak ada prefix NEXT_PUBLIC di sini, dan itu disengaja: seluruh pembacaan
# data CekHarga terjadi di Server Component, sehingga tidak ada satu pun kunci
# yang perlu sampai ke browser (PRD §10 "API key/model credential hanya di
# server; tidak dalam source, payload browser, atau log").
#
# INSFORGE_API_KEY setara service-role key: aksesnya penuh. Jangan pernah
# menaruhnya di variabel ber-prefix publik, di kode klien, atau di log.
INSFORGE_URL=
INSFORGE_API_KEY=

# Kunci publik InsForge, dipakai alur masuk admin di sisi server.
# Ambil dengan: npx @insforge/cli secrets get ANON_KEY
#
# Tetap TANPA prefix NEXT_PUBLIC walau namanya "anon". Browser CekHarga tidak
# pernah memanggil SDK langsung; seluruh autentikasi berjalan lewat Server
# Action dan Route Handler, jadi kunci ini tidak perlu ikut ke bundel klien.
INSFORGE_ANON_KEY=

# --------------------------------------------------------------------------
# Model bahasa (hanya wajib bila fitur cerita bebas di /assistant dipakai)
# --------------------------------------------------------------------------
# Kunci disediakan InsForge, tidak perlu akun OpenRouter terpisah. Tarik dengan:
#   npx @insforge/cli ai setup
#
# Server-only. Jangan pernah diberi prefix NEXT_PUBLIC.
#
# Kalau kunci ini kosong, kotak cerita bebas tidak ditampilkan sama sekali dan
# konsultasi tetap berjalan lewat pertanyaan terstruktur.
OPENROUTER_API_KEY=

# Opsional. Default: qwen/qwen3.5-9b (murah dan mendukung structured output).
# Model reasoning perlu perhatian: mode berpikirnya dimatikan di kode karena
# menghabiskan token tanpa menghasilkan jawaban.
OPENROUTER_CHAT_MODEL= 

# --------------------------------------------------------------------------
# Modul iklan (docs/ads/ADS-CONTEXT.md §14)
# --------------------------------------------------------------------------
# Rahasia HMAC untuk dedupe_key event iklan. Isi dengan string acak panjang,
# mis. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Bila kosong, dipakai INSFORGE_API_KEY sebagai cadangan.
ADS_EVENT_SECRET=

# Token Bearer untuk POST /api/ads/maintenance (job harian ringkas & hapus
# event > 90 hari). Tanpa nilai ini endpoint selalu menolak (401).
ADS_CRON_SECRET=

# 1 = isi setiap slot dengan contoh iklan fiktif dari public/ads untuk menilai
# tata letak. Tidak dilacak dan tidak ditagihkan. JANGAN aktifkan di produksi.
CEKHARGA_AD_PREVIEW=

# ID unit AdSense per slot (opsional), hanya dipakai bila slot ber-fallback
# "adsense" dan ID penerbit diisi di Admin > Iklan > Pengaturan. Contoh:
# ADSENSE_SLOT_HOME_TOP=1234567890

# --------------------------------------------------------------------------
# Worker impor (rencana kerja impor, Fase 1)
# --------------------------------------------------------------------------
# Token Bearer untuk POST /api/admin/import/worker, dipanggil InsForge
# Schedules tiap menit setelah ada URL publik. Tanpa nilai ini endpoint
# selalu menolak (401); penerapan tetap jalan lewat halaman batch.
IMPORT_WORKER_SECRET=

# Token Bearer untuk GET /api/cron/daily (vercel.json, 23.00 UTC = 06.00 WIB):
# pemeriksaan harga harian dari situs resmi, draft kedaluwarsa, retensi antrean.
# Cron Vercel mengirimkannya otomatis bila variabel ini diset di proyek Vercel.
# Tanpa nilai ini endpoint selalu menolak (401).
CRON_SECRET=

# URL publik produksi (https, tanpa path), mis. https://cekharga.id. Dipakai
# sitemap.xml, robots.txt, dan Open Graph. KOSONGKAN di lokal/preview: tanpa
# nilai ini robots.txt menolak semua crawler supaya domain preview tidak
# terindeks.
SITE_URL=
